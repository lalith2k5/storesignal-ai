"""Column mapper (gate G2): proposes the CHANNELS mapping so final-day mapping
is a ten-minute check. Scores every column against every target and writes
config/mapping_suggested.yaml with a confidence per column."""
import json
import re
from pathlib import Path

import pandas as pd
import yaml

from .config import ROOT, cfg
from .ingest import read_any, parse_ts

NAME_HINTS = {
    'source_id': ['id', 'uuid', 'ticket', 'review_id', 'note_id', 'comment_id'],
    'ts': ['date', 'time', 'timestamp', 'created', 'opened', 'posted'],
    'store_id': ['store', 'outlet', 'branch', 'shop', 'location', 'site'],
    'text_raw': ['text', 'comment', 'review', 'note', 'transcript', 'message', 'feedback', 'body', 'description'],
    'rating': ['rating', 'stars', 'score'],
}


def score_column(s, df, store_ids):
    name = s.lower()
    scores = {}
    for target, hints in NAME_HINTS.items():
        sc = 0.0
        if any(h in name for h in hints):
            sc += 1.0
        content = df[s].astype(str)
        if target == 'source_id':
            if content.nunique() / max(len(content), 1) >= 0.99 and content.str.len().max() <= 80:
                sc += 1.0
        elif target == 'ts':
            if parse_ts(df[s])[2] >= 90:
                sc += 1.0
        elif target == 'store_id':
            if store_ids is not None and content.isin(set(map(str, store_ids))).mean() >= 0.8:
                sc += 1.0
        elif target == 'text_raw':
            if content.str.len().median() >= 30 and content.nunique() > 10:
                sc += 1.0
        elif target == 'rating':
            if pd.to_numeric(df[s], errors='coerce').between(1, 5).mean() >= 0.9:
                sc += 1.0
        scores[target] = round(sc, 2)
    return scores


def automap(path, store_ids=None):
    df = read_any(path)
    out = {}
    for col in df.columns:
        sc = score_column(col, df, store_ids)
        best = max(sc, key=sc.get)
        if sc[best] > 0:
            out[col] = {'target': best, 'score': sc[best],
                        'confidence': 'high' if sc[best] >= 2 else 'medium' if sc[best] >= 1 else 'low'}
    return out


def run():
    raw = ROOT / cfg['paths']['raw']
    store_ids = None
    sm = ROOT / 'data' / 'synthetic' / 'records.parquet'
    if sm.exists():
        store_ids = pd.read_parquet(sm)['store_id']
    files = sorted(raw.glob('*')) if raw.exists() else []
    if not files:
        print('automap: no files in data/raw/ yet (expected on the final day)')
        return
    suggested = {}
    for f in files:
        if f.suffix.lower() in ('.csv', '.tsv', '.xlsx', '.xls', '.json', '.jsonl'):
            suggested[f.name] = automap(f, store_ids)
    with open(ROOT / 'config' / 'mapping_suggested.yaml', 'w', encoding='utf-8') as fh:
        yaml.safe_dump(suggested, fh, allow_unicode=True, sort_keys=False)
    print('automap: wrote config/mapping_suggested.yaml')
    print(json.dumps(suggested, indent=2, default=str))
