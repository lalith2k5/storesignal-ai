"""Ingestion: read the four channels and the store master, validate, quarantine."""
import csv
import json
from pathlib import Path

import pandas as pd

from .adapters import CHANNELS, STORE_MASTER
from .config import ROOT, cfg

ENCODINGS = ['utf-8-sig', 'utf-8', 'cp1252', 'latin-1']


def read_any(path):
    """Multi-format loader: csv/tsv with delimiter sniffing, xlsx, json, jsonl."""
    p = Path(path)
    if p.suffix.lower() in ('.xlsx', '.xls'):
        return pd.read_excel(p, dtype=str)
    if p.suffix.lower() == '.json':
        return pd.read_json(p, dtype=str)
    if p.suffix.lower() == '.jsonl':
        return pd.read_json(p, lines=True, dtype=str)
    enc = None
    head = ''
    for e in ENCODINGS:
        try:
            with open(p, encoding=e) as fh:
                head = fh.read(65536)
            enc = e
            break
        except UnicodeDecodeError:
            continue
    if enc is None:
        raise ValueError(f'Could not decode {p} with {ENCODINGS}')
    try:
        delim = csv.Sniffer().sniff(head[:4096], delimiters=',;\t|').delimiter
    except csv.Error:
        delim = ','
    return pd.read_csv(p, sep=delim, dtype=str, encoding=enc, encoding_errors='replace')


def parse_ts(series):
    """ISO first; otherwise compare day-first and month-first and keep the
    higher success rate. Logs the decision in data_quality.json."""
    s = pd.to_datetime(series, errors='coerce')
    if s.notna().mean() >= 0.95:
        return s, 'iso', round(100 * s.notna().mean(), 2)
    dfirst = pd.to_datetime(series, errors='coerce', dayfirst=True)
    mfirst = pd.to_datetime(series, errors='coerce', dayfirst=False)
    rate_d, rate_m = dfirst.notna().mean(), mfirst.notna().mean()
    if rate_d >= rate_m:
        return dfirst, 'dayfirst', round(100 * rate_d, 2)
    return mfirst, 'monthfirst', round(100 * rate_m, 2)


def load_channel(name, spec, raw):
    df = read_any(raw / spec['file'])
    df = df.rename(columns=spec['map'])
    for c in ['source_id', 'ts', 'store_id', 'text_raw', 'rating']:
        if c not in df:
            df[c] = None
    df['channel'] = name
    df['record_id'] = name + '-' + df['source_id'].astype(str)
    parsed, mode, rate = parse_ts(df['ts'])
    df['ts'] = parsed
    if df['ts'].dt.tz is None:
        df['ts'] = df['ts'].dt.tz_localize(cfg['timezone'], nonexistent='shift_forward',
                                           ambiguous='NaT').dt.tz_convert('UTC')
    df['rating'] = pd.to_numeric(df['rating'], errors='coerce')
    return df[['record_id', 'channel', 'ts', 'store_id', 'text_raw', 'rating']], {'mode': mode, 'rate': rate}


def validate(df):
    """Quarantine only empty text and duplicate record ids; keep missing store/ts."""
    df['text_raw'] = df['text_raw'].fillna('').astype(str)
    df['has_store'] = df['store_id'].notna()
    df['has_ts'] = df['ts'].notna()
    reason = pd.Series('', index=df.index)
    reason[df['text_raw'].str.strip() == ''] = 'empty_text'
    reason[df['record_id'].duplicated(keep='first')] = 'duplicate_record_id'
    good = df[reason == ''].copy()
    bad = df[reason != ''].copy()
    bad['reason'] = reason[reason != '']
    return good, bad


def run():
    out = ROOT / cfg['paths']['interim']
    out.mkdir(parents=True, exist_ok=True)
    if cfg.get('data_mode') == 'synthetic':
        df = pd.read_parquet(ROOT / cfg['paths']['raw'].replace('raw', 'synthetic') / 'records.parquet')
        good, bad = validate(df)
        report = {
            'data_mode': 'synthetic',
            'rows_per_channel': good['channel'].value_counts().to_dict(),
            'quarantined': bad['reason'].value_counts().to_dict(),
            'missing_ts_pct': round(100 * (~good['has_ts']).mean(), 2),
            'missing_store_pct': round(100 * (~good['has_store']).mean(), 2),
            'date_range': [str(good['ts'].min()), str(good['ts'].max())],
            'records_per_store': good.groupby('store_id').size().describe().round(1).to_dict(),
            'exact_duplicate_text_pct': round(100 * good.duplicated(['store_id', 'text_raw']).mean(), 2),
            'text_len_by_channel': {
                ch: g['text_raw'].str.len().describe().round(1).to_dict()
                for ch, g in good.groupby('channel')
            },
        }
    else:
        raw = ROOT / cfg['paths']['raw']
        parts, parse_info = [], {}
        for name, spec in CHANNELS.items():
            df, info = load_channel(name, spec, raw)
            parts.append(df)
            parse_info[name] = info
        df = pd.concat(parts, ignore_index=True)
        stores = read_any(raw / STORE_MASTER['file']).rename(columns=STORE_MASTER['map'])
        df = df.merge(stores[['store_id', 'region']], on='store_id', how='left')
        good, bad = validate(df)
        report = {
            'data_mode': 'real',
            'date_parse': parse_info,
            'rows_per_channel': good['channel'].value_counts().to_dict(),
            'quarantined': bad['reason'].value_counts().to_dict(),
            'missing_ts_pct': round(100 * (~good['has_ts']).mean(), 2),
            'missing_store_pct': round(100 * (~good['has_store']).mean(), 2),
            'date_range': [str(good['ts'].min()), str(good['ts'].max())],
            'records_per_store': good.groupby('store_id').size().describe().round(1).to_dict(),
            'exact_duplicate_text_pct': round(100 * good.duplicated(['store_id', 'text_raw']).mean(), 2),
            'text_len_by_channel': {
                ch: g['text_raw'].str.len().describe().round(1).to_dict()
                for ch, g in good.groupby('channel')
            },
        }
    good.to_parquet(out / 'records.parquet')
    bad.to_parquet(out / 'quarantine.parquet')
    json.dump(report, open(out / 'data_quality.json', 'w'), indent=2, default=str)
    print(json.dumps(report, indent=2, default=str))
